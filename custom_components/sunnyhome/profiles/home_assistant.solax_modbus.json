    },
    "discharge_period1_start": {
      "entity": "time.discharge_start_1"
    },
    "discharge_period1_end": {
      "entity": "time.discharge_end_1"
    },
    "period2_enabled": {
      "entity": "switch.charge_and_discharge_period2_enable"
    },
    "charge_period2_start": {
